<tr><td rowspan="1" colspan="3" data-tags="">TC-001-052 - [Use case] Create user with all dropdown selections</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>/login/index.php<datalist><option>/login/index.php</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>css=#username<datalist><option>css=#username</option></datalist></td><td>10000</td></tr>
<tr><td>type</td><td>css=#username<datalist><option>css=#username</option></datalist></td><td>admin</td></tr>
<tr><td>type</td><td>css=#password<datalist><option>css=#password</option></datalist></td><td>admin</td></tr>
<tr><td>click</td><td>css=#loginbtn<datalist><option>css=#loginbtn</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>css=.navbar<datalist><option>css=.navbar</option></datalist></td><td>10000</td></tr>
<tr><td>open</td><td>/user/editadvanced.php?id=-1<datalist><option>/user/editadvanced.php?id=-1</option></datalist></td><td></td></tr>
<tr><td>waitForElementPresent</td><td>id_username<datalist><option>id_username</option></datalist></td><td>10000</td></tr>
<tr><td>type</td><td>id_username<datalist><option>id_username</option></datalist></td><td>tc001_052</td></tr>
<tr><td>select</td><td>id_auth<datalist><option>id_auth</option></datalist></td><td>label=Manual accounts</td></tr>
<tr><td>waitForElementPresent</td><td>id_newpassword<datalist><option>id_newpassword</option></datalist></td><td>10000</td></tr>
<tr><td>click</td><td>css=#fitem_id_newpassword [data-passwordunmask="edit"]<datalist><option>css=#fitem_id_newpassword [data-passwordunmask="edit"]</option></datalist></td><td></td></tr>
<tr><td>type</td><td>id_newpassword<datalist><option>id_newpassword</option></datalist></td><td>ValidPass123!</td></tr>
<tr><td>type</td><td>id_firstname<datalist><option>id_firstname</option></datalist></td><td>Test</td></tr>
<tr><td>type</td><td>id_lastname<datalist><option>id_lastname</option></datalist></td><td>User</td></tr>
<tr><td>type</td><td>id_email<datalist><option>id_email</option></datalist></td><td>tc001_052@gmail.com</td></tr>
<tr><td>select</td><td>id_country<datalist><option>id_country</option></datalist></td><td>label=Vietnam</td></tr>
<tr><td>select</td><td>id_timezone<datalist><option>id_timezone</option></datalist></td><td>label=Asia/Ho_Chi_Minh</td></tr>
<tr><td>verifySelectedValue</td><td>id_lang<datalist><option>id_lang</option></datalist></td><td>en</td></tr>
<tr><td>click</td><td>id_submitbutton<datalist><option>id_submitbutton</option></datalist></td><td></td></tr>
<tr><td>pause</td><td>1200<datalist><option>1200</option></datalist></td><td></td></tr>
<tr><td>verifyTextPresent</td><td><datalist><option>User created successfully</option></datalist></td><td>Changes saved</td></tr>
</tbody></table>
</body>
</html>